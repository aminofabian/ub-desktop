{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "bash scripts/check-windows-resources.sh || bash src-tauri/scripts/check-windows-resources.sh"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "Resources-windows/": "resources/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
